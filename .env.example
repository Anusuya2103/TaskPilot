# ============================================================================
# TaskPilot — environment configuration
# Copy to `.env` (cp .env.example .env) and fill in what you need.
# Everything below has a working default, so `docker compose up` works with
# an empty .env file (the agent falls back to deterministic demo mode).
# ============================================================================

# --- Core -------------------------------------------------------------------
# development | demo | production
TASKPILOT_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
# Optional. When set, mutating API endpoints require `X-API-Key`.
TASKPILOT_API_KEY=

# Public base URLs used for CORS + report links
TASKPILOT_PUBLIC_API_URL=http://localhost:8000
TASKPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---------------------------------------------------------------
# Postgres in docker-compose; SQLite fallback for local/tests:
#   TASKPILOT_DATABASE_URL=sqlite+aiosqlite:///./taskpilot.db
TASKPILOT_DATABASE_URL=postgresql+asyncpg://taskpilot:taskpilot@localhost:5432/taskpilot
TASKPILOT_AUTO_CREATE_TABLES=true

# --- LLM provider -----------------------------------------------------------
# anthropic | openai | gemini | scripted
TASKPILOT_LLM_PROVIDER=anthropic
TASKPILOT_LLM_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible gateway (Azure, OpenRouter, vLLM, ...)
TASKPILOT_LLM_BASE_URL=
TASKPILOT_LLM_TEMPERATURE=0.0
TASKPILOT_LLM_MAX_TOKENS=4096
TASKPILOT_LLM_TIMEOUT_SECONDS=90
# Hard fail instead of silently falling back to demo mode when the key is missing
TASKPILOT_ALLOW_SCRIPTED_FALLBACK=true

# --- Agent loop -------------------------------------------------------------
TASKPILOT_MAX_STEP_ATTEMPTS=2
TASKPILOT_MAX_REPLANS=2
TASKPILOT_MAX_STEPS=20
TASKPILOT_RUN_TIMEOUT_SECONDS=900
TASKPILOT_STEP_TIMEOUT_SECONDS=120
TASKPILOT_APPROVAL_TIMEOUT_SECONDS=300
# low/medium risk steps run without a human; high risk ALWAYS pauses (not configurable).
# Set to false for "strict mode", where medium-risk steps pause too.
TASKPILOT_AUTO_APPROVE_LOW_RISK=true

# --- Browser ----------------------------------------------------------------
TASKPILOT_BROWSER_HEADLESS=true
TASKPILOT_BROWSER_TIMEOUT_MS=20000
TASKPILOT_ARTIFACT_DIR=./artifacts
# Comma separated allowlist. `*` allows any public host.
TASKPILOT_DOMAIN_ALLOWLIST=localhost,127.0.0.1,mockshop,*.wikipedia.org,books.toscrape.com,openlibrary.org,httpbin.org,*.github.com,*.google.com
TASKPILOT_BLOCK_PRIVATE_NETWORKS=false

# --- MCP --------------------------------------------------------------------
TASKPILOT_MCP_ENABLED=true
# JSON array of {"name","transport":"stdio"|"sse","command"|"url","args":[],"env":{}}
TASKPILOT_MCP_SERVERS=[{"name":"fetch","transport":"stdio","command":"uvx","args":["mcp-server-fetch"]},{"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
TASKPILOT_MCP_STARTUP_TIMEOUT_SECONDS=25

# --- Demo targets -----------------------------------------------------------
MOCKSHOP_BASE_URL=http://localhost:9000
BOOKS_BASE_URL=https://books.toscrape.com

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SSE_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
